# Copy to .env and fill in:   cp .env.example .env
# Generate each token with:   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The gateway refuses to start if a value is missing or the two tokens are equal.

# Bearer token for the bridge: full access to /v1 and the legacy /api routes
TOKEN_BRIDGE=
# Bearer token for automations: can only send text to OWNER_PHONE
TOKEN_NOTIFY=
# Your personal number, digits only, with country and area code (e.g. 5571999999999)
OWNER_PHONE=

# Optional: days to keep message content, attachment keys and downloaded files (default 7)
# MESSAGE_RETENTION_DAYS=7
